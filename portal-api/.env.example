# Copie para portal-api/.env (o start-portal.sh carrega automaticamente)
# cp portal-api/.env.example portal-api/.env

# MySQL (padrão: localhost root/root)
DB_URL=jdbc:mysql://localhost:3306/nfse_portal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USER=root
DB_PASSWORD=root

# Esatta Laboratório (homologação)
CERTIFICADO_PATH=/home/aurelio/FONTES/SPRING/nfse2/EsattaLaboratorio_safe1283.pfx
CERTIFICADO_SENHA=safe1283
NFSE_AMBIENTE=homologacao
MUNICIPIO_IBGE=4310009
PREFEITURA=Ibiruba/RS
NFSE_JWT_SECRET=change-me-in-production-use-long-random-string
# 0 = token embed permanente (padrão iframe). Ex.: 480 = expira em 8 horas.
NFSE_JWT_EXP_MIN=0
NFSE_ADMIN_SECRET=admin-change-me
NFSE_EMBED_BASE_URL=http://localhost:3000
PORT=8080
CORS_ORIGINS=http://localhost:3000

# E-mail DANFSe (Gmail: use senha de app)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Synki NFS-e

# Reenvio automatico do PDF quando ADN estiver indisponivel
NFSE_PDF_RETRY_ENABLED=true
NFSE_PDF_RETRY_INTERVAL_MS=60000
NFSE_PDF_RETRY_MAX=72

# Import legado Fluxo (MySQL)
FLUXO_IMPORT_ENABLED=false
FLUXO_IMPORT_ON_STARTUP=false
FLUXO_DB_HOST=100.84.22.20
FLUXO_DB_NAME=fluxo
FLUXO_DB_USER=root
FLUXO_DB_PASSWORD=
FLUXO_CLIENTE_EMPRESA_ID=4
FLUXO_DEMO_EMPRESA_ID=1
FLUXO_DEFAULT_SENHA=fluxo123
