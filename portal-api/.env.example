# Copie para portal-api/.env
# cp portal-api/.env.example portal-api/.env

# --- Banco ---
DB_URL=jdbc:mysql://localhost:3306/nfse_portal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USER=root
DB_PASSWORD=root

# --- Segurança (OBRIGATÓRIO trocar em produção) ---
NFSE_JWT_SECRET=change-me-in-production-use-long-random-string
NFSE_JWT_EXP_MIN=480
NFSE_ADMIN_SECRET=admin-change-me
NFSE_EMBED_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PORT=8080

# --- Perfil (prod desliga demo seed e valida segredos) ---
# SPRING_PROFILES_ACTIVE=prod

# --- Certificado demo (opcional, só dev/homolog) ---
# CERTIFICADO_PATH=/caminho/para/certificado.pfx
# CERTIFICADO_SENHA=
# NFSE_AMBIENTE=homologacao
# MUNICIPIO_IBGE=4310009
# PREFEITURA=Ibiruba/RS

# --- E-mail ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SyncNota

# Stripe (cobrança)
STRIPE_ENABLED=false
STRIPE_ENV=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/conta/assinatura

# Setup automático: ./configurar-stripe.sh sk_test_...

# --- Dunning (avisos de cobrança) ---
NFSE_DUNNING_CRON=0 0 9 * * *

# --- PDF retry NFS-e ---
NFSE_PDF_RETRY_ENABLED=false
NFSE_PDF_RETRY_INTERVAL_MS=60000
NFSE_PDF_RETRY_MAX=72

# --- Import legado Fluxo (desligado por padrão) ---
FLUXO_IMPORT_ENABLED=false
# FLUXO_DB_HOST=127.0.0.1
# FLUXO_DB_NAME=fluxo
# FLUXO_DB_USER=nfse
# FLUXO_DB_PASSWORD=
# FLUXO_DEFAULT_SENHA=
# FLUXO_DEMO_EMPRESA_ID=0
# FLUXO_CONTA_NOME=Cereais Werlang
# FLUXO_OWNER_EMAIL=nfe.cloviswerlang@cereaiswerlang.com.br
# FLUXO_OWNER_NOME=Clovis Antonio Werlang
# FLUXO_OPERADORES=stefanni@cereaiswerlang.com.br|Stefanni Milena Antunes;eduarda@cereaiswerlang.com.br|Maria Eduarda Carpes Schneider
