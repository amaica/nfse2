# SyncNota — produção (copie para portal-api/.env no servidor)
# cp portal-api/.env.production.example portal-api/.env

SPRING_PROFILES_ACTIVE=prod

# --- Banco ---
DB_URL=jdbc:mysql://SEU_HOST:3306/nfse_portal?useSSL=true&serverTimezone=America/Sao_Paulo
DB_USER=
DB_PASSWORD=

# --- Segurança (OBRIGATÓRIO — valores únicos) ---
NFSE_JWT_SECRET=                    # mín. 32 chars aleatórios
NFSE_JWT_EXP_MIN=480
NFSE_ADMIN_SECRET=                  # mín. 16 chars aleatórios
NFSE_EMBED_BASE_URL=https://app.seudominio.com.br
CORS_ORIGINS=https://app.seudominio.com.br
PORT=8080

# --- E-mail transacional ---
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SyncNota

# --- Stripe (cobrança) ---
STRIPE_ENABLED=true
STRIPE_ENV=live
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...     # webhook do Dashboard → /api/billing/stripe/webhook
STRIPE_PORTAL_RETURN_URL=https://app.seudominio.com.br/conta/assinatura

# --- Opcional ---
NFSE_DUNNING_CRON=0 0 9 * * *
NFSE_PDF_RETRY_ENABLED=true
